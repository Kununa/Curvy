<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Like a trimmed release: any reflection-based JSON left in the engine throws here. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The tests also run as Native AOT, like the app ships (dotnet publish -c Release, then run
         Curvy.Core.Tests.exe; the release workflow does this). Also turns on the AOT analyzers in
         every build, so reflection-based assertions (e.g. IsEquivalentTo without a comparer) warn. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageReference Include="TUnit" Version="1.87.12" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Assertions.Enums" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Curvy.Core\Curvy.Core.csproj" />
  </ItemGroup>

</Project>
