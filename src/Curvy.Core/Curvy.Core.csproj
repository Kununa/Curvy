<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Declares the library trim-safe and turns on the trim analyzers: reflection the trimmer can't
         see (e.g. reflection-based System.Text.Json) becomes a build warning. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

</Project>
