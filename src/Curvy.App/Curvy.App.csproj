<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Curvy.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\curvy.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Bundle the WinAppSDK runtime: no separate runtime install needed, and `dotnet watch run`
         hot reload survives incremental rebuilds (Reactor docs, packaging guide). -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <!-- Icons are generated from Assets\Icon\*.svg by tools/icons/build_icons.py (commit the .ico files). -->
    <Content Include="Assets\curvy.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\tray-*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.18" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.261119100">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Installer + uninstaller (built by .github/workflows/release.yml). Keep in step with the vpk
         tool version in dotnet-tools.json. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- Only the Windows App SDK parts Curvy uses (WinUI, plus Runtime for the self-contained
         deployment; Foundation/AppLifecycle comes with WinUI), pinned to 2.7.0: Reactor alone would
         resolve its 2.2 minimums. Not the full Microsoft.WindowsAppSDK metapackage, which also ships
         the Windows AI/ML, Search and Widgets components (~55 MB of unused DLLs). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.7.0" />
  </ItemGroup>

  <!--
    Debug-only: reference Microsoft.UI.Reactor.Devtools and turn on the
    Reactor.DevtoolsSupport switch. Together they make the Reactor devtools
    available without turning them on: to get the in-app dev menu, launch with
    the devtools "app" subcommand and render DevtoolsMenu(...) in your UI.
    Release / Publish builds drop the package and the host-config switch so the
    trim / AOT analyzers stay happy. To enable devtools in Release too, move
    these into the unconditioned ItemGroup above.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.UI.Reactor.Devtools" Version="0.1.0-preview.18" />
    <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport" Value="true" Trim="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Curvy.Core\Curvy.Core.csproj" />
  </ItemGroup>


  <!-- Publish Properties: Release publishes are Native AOT (one native Curvy.App.exe, no bundled
       .NET runtime; trimming is implied). Needs the MSVC linker (VS Build Tools "Desktop development
       with C++"; GitHub's windows runners have it). Debug builds and dotnet watch stay JIT.
       AOT-safe because all JSON is source-generated, Curvy.Core is IsAotCompatible, there are no
       trim/AOT warnings, and WinUI-derived classes (EqCanvas) are partial so C#/WinRT can generate
       their interop code. A full AOT build was run end to end (all pages, AutoEQ search + fetch,
       graph). Installer 133 MB (untrimmed JIT) -> 40 MB. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <PublishAot>true</PublishAot>
    <!-- The native exe's symbols (~80 MB) stay in obj/bin, out of the published folder and installer. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
